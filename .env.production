# Node environment
NODE_ENV=production
# Application name
NEXT_PUBLIC_APP_NAME="Universal Inventory Management"
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BACKEND_URL=


# Currency formatting (used by lib/utils/format.ts)
NEXT_PUBLIC_CURRENCY_CODE=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
NEXT_PUBLIC_CURRENCY_POSITION=left

# Name of the backend session cookie checked by proxy.ts for route protection.
# Must exactly match the Laravel session cookie name (config/session.php -> 'cookie').
# Laravel's default is Str::slug(APP_NAME) . '-session' (hyphen), e.g. APP_NAME=Laravel -> laravel-session.
# Recommended: set SESSION_COOKIE explicitly in the backend .env so it never changes when APP_NAME changes.
AUTH_SESSION_COOKIE=

# Storefront mock-data opt-in. Set to "true" ONLY in local dev where the storefront
# backend is absent; mock products/orders are then rendered. Leave UNSET (or "false")
# in any real/staging/production deployment so fabricated data is never shown to users.
NEXT_PUBLIC_USE_MOCK=false

# ---------------------------------------------------------------------------
# API client (lib/api/client.ts)
# ---------------------------------------------------------------------------
# Extra allowed latency (ms) added to the backend's Retry-After / timeout budget.
# Optional; defaults are applied in the client if unset.
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Offline / connectivity detection (lib/api/network-monitor.ts)
# ---------------------------------------------------------------------------
# While the app believes it is offline it periodically re-checks the API so the
# UI can recover on its own. The probe is only ever sent while already
# disconnected — when healthy there are zero extra requests.
#
# Endpoint used for the reachability probe. Any HTTP status (200, 401, 404, 500)
# counts as "server answered", so this only needs to exist and be cheap.
NEXT_PUBLIC_NETWORK_PROBE_URL=/api/v1/health

# Give up on a probe after this long (ms). Keep it short: it runs on a backoff
# ladder while offline.
NEXT_PUBLIC_NETWORK_PROBE_TIMEOUT_MS=5000

# Set to false to disable background re-checking entirely. The offline banner and
# the useOffline hook still work; only the automatic recovery probe is removed,
# leaving recovery dependent on user-initiated requests.
NEXT_PUBLIC_NETWORK_RECOVERY_PROBE=true

# ---------------------------------------------------------------------------
# Image domains (next.config.ts remotePatterns + lib/image-url.ts)
# ---------------------------------------------------------------------------
# Hostname of the backend that serves /storage/* images. Already read by
# lib/image-url.ts; also add the hostname to next.config.ts remotePatterns if
# you serve optimized <Image> from it.
# NEXT_PUBLIC_BACKEND_URL is reused for this (see above).

# Optional additional remote image hosts (comma-separated) for next/image.
# Example: NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com,cdn.example.com
NEXT_PUBLIC_IMAGE_HOSTS=

# ---------------------------------------------------------------------------
# Analytics (optional — leave blank to disable)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# ---------------------------------------------------------------------------
# Payment gateways (optional — server-side keys belong in the backend .env,
# never expose secret keys here; only public/publishable keys are safe)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# NEXT_PUBLIC_SSLWARE_MERCHANT_ID=

# ---------------------------------------------------------------------------
# Feature flags (optional toggles)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_WISHLIST=true
# NEXT_PUBLIC_ENABLE_FLASH_SALE=true
# NEXT_PUBLIC_ENABLE_POS=true

# ---------------------------------------------------------------------------
# Deployment notes
# ---------------------------------------------------------------------------
# .env.production must NOT be committed. Inject real values via CI/CD secrets
# or the host's environment configuration. Add it to .gitignore.